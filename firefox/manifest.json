{
  "manifest_version": 3,
  "name": "__MSG_app__",
  "description": "__MSG_description__",
  "version": "0.1.19",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "{86208952-d93f-483a-bace-e85ac03124dc}",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"], "optional": ["websiteActivity"] }
    }
  },
  "incognito": "not_allowed",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "host_permissions": ["*://*/*"],
  "content_scripts": [{ "matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }],
  "icons": { "16": "icon.svg", "32": "icon.svg", "48": "icon.svg", "96": "icon.svg" },
  "action": { "default_title": "__MSG_app__", "default_popup": "popup.html", "default_icon": "icon.svg" },
  "background": { "scripts": ["background.js"] }
}
